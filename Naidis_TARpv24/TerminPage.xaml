<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Naidis_TARpv24.TerminPage"
             Title="TerminPage">
    <Grid RowDefinitions="Auto, *" Padding="20" RowSpacing="20">

        <!-- Ülemine osa: Uue termini lisamine -->
        <VerticalStackLayout Grid.Row="0" Spacing="10">
            <Label Text="Lisa uus mõiste (nt. Pythoni muutuja):" FontAttributes="Bold" FontSize="16"/>
            <Entry Placeholder="Mõiste" Text="{Binding UusNimi}" />
            <Entry Placeholder="Lühike selgitus" Text="{Binding UusSelgitus}" />
            <Button Text="Salvesta" Command="{Binding LisaCommand}" BackgroundColor="#2196F3" TextColor="White"/>
        </VerticalStackLayout>

        <!-- Alumine osa: Terminid -->
        <CollectionView Grid.Row="1" ItemsSource="{Binding Terminid}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:TerminItem">
                    <Frame Margin="0,0,0,10" Padding="15" BackgroundColor="#f8f9fa" CornerRadius="8">

                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="15">

                            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" HorizontalOptions="Center">
                                <CheckBox IsChecked="{Binding KasSelge}" Color="#4CAF50" />
                                <Label Text="Selge" FontSize="10" TextColor="Gray" HorizontalOptions="Center"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="{Binding Nimi}" FontAttributes="Bold" FontSize="16" TextColor="Black"/>
                                <Label Text="{Binding Selgitus}" FontSize="14" TextColor="#555555" LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>

                            <!-- Kustutamise nupp otsib käsu üles ViewModelist -->
                            <Button Grid.Column="2" 
                                    Text="Kustuta" 
                                    BackgroundColor="#cc0000"
                                    VerticalOptions="Center"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type local:TerminViewModel}}, Path=KustutaCommand}"
                                    CommandParameter="{Binding .}" />

                        </Grid>

                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>